diff --git a/crates/tomoe/src/handlers.rs b/crates/tomoe/src/handlers.rs
index 7ba3060..d0b5c07 100644
--- a/crates/tomoe/src/handlers.rs
+++ b/crates/tomoe/src/handlers.rs
@@ -561,6 +561,22 @@ impl XdgDecorationHandler for Tomoe {
         // preference — forcing a mode mid-handshake breaks older SDL2 apps
         // (https://github.com/libsdl-org/SDL/issues/8173), and a client that
         // insists on CSD will draw it regardless.
+        //
+        // force_server_side_decorations opts into refusing CLIENT requests:
+        // GTK4/libadwaita draws a CSD titlebar when granted CLIENT, which
+        // fights the uniform tiled border-only look. When set, hand back
+        // ServerSide so such toolkits skip their own titlebar.
+        //
+        // Global exception: NONE requests pass through untouched. A client
+        // that explicitly asks for no decorations (GTK set_decorated(false),
+        // e.g. stremio) gets none — the forcing only converts CSD clients.
+        let mode = if self.lua.settings().force_server_side_decorations
+            && mode == zxdg_toplevel_decoration_v1::Mode::ClientSide
+        {
+            zxdg_toplevel_decoration_v1::Mode::ServerSide
+        } else {
+            mode
+        };
         toplevel.with_pending_state(|state| {
             state.decoration_mode = Some(mode);
         });
