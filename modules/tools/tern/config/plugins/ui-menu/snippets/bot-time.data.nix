[
  {
    select = "[data-role^='omp.bot.time.']";
    set = [
      ["align-self" "stretch"]
      ["margin" "-2px 0 -8px"]
      ["text-align" "center"]
      ["font-size" "12px"]
      ["line-height" "16px"]
      ["color" "var(--t2)"]
      ["font-family" "var(--sans)"]
    ];
  }
  {
    select = "[data-role='omp.bot.took']";
    set = [
      ["opacity" "0.45"]
      ["font-size" "0.85em"]
    ];
  }
]
