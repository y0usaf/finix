{
  "theme": "System",
  "copy_on_select": true,
  "cursor": {
    "programs": true,
    "trail": "warp"
  },
  "link_target": "Browser",
  "contrast": "Always",
  "layout": "Rail",
  "font_size": 20,
  "padding_x": 0,
  "padding_y": 0,
  "system_title_bar": true,
  "status_bar": true,
  "material": "Glass",
  "opacity": 0,
  "blur": 0,
  "plugins_disabled": [
    "chime"
  ],
  "surface_fold": true,
  "new_tabs": "Home",
  "agent_placement": "new_tab",
  "snap_text": true,
  "frames_queued": 1,
  "renderer": "gpu",
  "carly": {
    "model": "openai-codex/gpt-6.1-terra:high"
  },
  "keybinds": {
    "ctrl+delete": "close_tab",
    "ctrl+h": "focus_pane:left",
    "ctrl+j": "next_tab",
    "ctrl+k": "previous_tab",
    "ctrl+l": "focus_pane:right",
    "ctrl+shift+j": "move_tab_right",
    "ctrl+shift+k": "move_tab_left",
    "ctrl+tab": "show_previous_tab"
  },
  "agents": {
    "custom": [
      {
        "id": "dsh",
        "name": "DeepSeek",
        "command": "dsh-acp"
      }
    ]
  }
}
