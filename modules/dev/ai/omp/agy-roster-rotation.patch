 const CURSOR_PLAN_POLICY_MARKER_PATTERN = /\bERROR_RATE_LIMITED_CHANGEABLE\b/i;
 const CURSOR_PLAN_POLICY_PATTERN = /\bNamed models unavailable\b|\bModel unavailable on\b|\bFree plans can only use\b/i;
 
+const AGY_UNKNOWN_MODEL_PATTERN = /^Unknown model ID: (\S+)$/;
+
+function agyUnknownModelFromText(text: string): string | undefined {
+	return AGY_UNKNOWN_MODEL_PATTERN.exec(text.trim())?.[1];
+}
+
+function isAgyUnknownModelText(text: string, provider: string | undefined, modelId: string | undefined): boolean {
+	return provider === "antigravity-cli" && modelId !== undefined && agyUnknownModelFromText(text) === modelId;
+}
+
+function agyUnknownModel(error: unknown, depth = 0): string | undefined {
+	if (depth > 6) return undefined;
+	if (typeof error === "string") return agyUnknownModelFromText(error);
+	if (!error || typeof error !== "object") return undefined;
+	for (const key of ["errorMessage", "message"] as const) {
+		const text = key in error ? (error as Record<string, unknown>)[key] : undefined;
+		const model = typeof text === "string" ? agyUnknownModelFromText(text) : undefined;
+		if (model !== undefined) return model;
+	}
+	return "cause" in error ? agyUnknownModel(error.cause, depth + 1) : undefined;
+}
+
 function isCursorPlanPolicyText(text: string): boolean {
