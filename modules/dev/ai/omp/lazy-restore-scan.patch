+export function tailMayHoldInterruptedTurn(entries: readonly SessionEntry[]): boolean {
+	// A recorded normal exit with nothing pending closes the session: hasRestorableTurn
+	// stops at it too, whatever the conversation tail looks like.
+	for (let index = entries.length - 1; index >= 0; index--) {
