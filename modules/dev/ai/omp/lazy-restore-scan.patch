+
+/**
+ * The records at the start of a transcript, read from at most `maxBytes`, and
+ * whether that window covered the whole file. A window that ends mid-record drops
+ * that record; callers that need certainty check `complete`.
+ */
+export async function readSessionPrefix(
+	filePath: string,
+	maxBytes = SESSION_METADATA_PREFIX_BYTES,
+): Promise<{ entries: FileEntry[]; complete: boolean }> {
+	const handle = await fs.open(filePath, "r");
+	try {
+		const { size } = await handle.stat();
+		const length = Math.min(size, Math.max(1, maxBytes));
+		const window = new Uint8Array(length);
+		await handle.read(window, 0, length, 0);
+		const complete = length >= size;
