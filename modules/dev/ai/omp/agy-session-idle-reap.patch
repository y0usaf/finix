+
+function retireSessionWhenIdle(
+	sessions: Map<string, ProviderSessionState>,
+	key: string,
+	host: AgyHost,
+): void {
+	clearTimeout(sessionIdleTimers.get(host));
+	const timer = setTimeout(() => {
+		sessionIdleTimers.delete(host);
+		if (sessions.get(key) !== host) return;
+		if (host.hasPendingTurn) {
+			retireSessionWhenIdle(sessions, key, host);
+			return;
+		}
+		host.close();
+		sessions.delete(key);
+	}, IDLE_MS);
+	timer.unref();
+	sessionIdleTimers.set(host, timer);
+}
