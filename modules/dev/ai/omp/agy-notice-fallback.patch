+const AGY_NOTICE_MAX_CHARS = 2048;
+const AGY_API_ERROR_PATTERN = /^API error(?:\s*\(attempt \d+\))?:/i;
+const AGY_ACCOUNT_DISABLED_PATTERN =
+	/\bthis service has been disabled in this account\b|\bverify your account to continue\b/i;
+
+function isPotentialAgyNoticeBuffer(text: string): boolean {
+	if (text.length > AGY_NOTICE_MAX_CHARS) return false;
+	if (text.trim().length === 0) return true;
+	const lines = text.split("\n").filter(line => line.trim().length > 0);
+	return lines.every(line => {
+		const trimmed = line.trimStart();
+		return trimmed === "⚠" || trimmed.startsWith("⚠ ");
+	});
+}
+
+function extractAgyNoticeError(text: string | undefined): string | undefined {
+	if (!text) return undefined;
+	const lines = text
+		.split("\n")
+		.map(line => line.trim())
+		.filter(line => line.length > 0);
+	if (lines.length === 0 || !lines.every(line => line.startsWith("⚠ "))) return undefined;
+	const notices = lines.map(line => line.slice(2).trim()).filter(line => line.length > 0);
+	const last = notices.at(-1);
+	if (!last) return undefined;
+	if (
+		AIError.matchesUsageLimitText(last) ||
+		AGY_API_ERROR_PATTERN.test(last) ||
+		AGY_ACCOUNT_DISABLED_PATTERN.test(last)
+	) {
+		return last;
+	}
+	return undefined;
+}
+
 function mapAgyError(error: unknown): Error {
 	if (error instanceof RequestError && /not logged in|unauthenticated|authentication required/i.test(error.message)) {
 		return new Error("Antigravity CLI is not signed in. Run /login and choose Antigravity CLI.");
