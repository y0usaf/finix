+const MAX_REPLAY_BYTES = 120_000;
+const MAX_HISTORICAL_PART_CHARS = 16_000;
+
+function clipHistoryText(text: string): string {
+	if (text.length <= MAX_HISTORICAL_PART_CHARS) return text;
+	const omitted = text.length - MAX_HISTORICAL_PART_CHARS;
+	return `${text.slice(0, MAX_HISTORICAL_PART_CHARS)}\n[... truncated ${omitted} chars ...]`;
+}
+
+function replayMessageBlocks(message: Message): { blocks: ContentBlock[]; bytes: number } {
+	const blocks: ContentBlock[] = [];
+	let bytes = 0;
+	const pushText = (text: string) => {
+		blocks.push({ type: "text", text });
+		bytes += Buffer.byteLength(text, "utf8");
+	};
+	const tag = message.role === "toolResult" ? "tool_result" : message.role;
+	const attrs =
+		message.role === "toolResult"
+			? ` id=${JSON.stringify(message.toolCallId)} name=${JSON.stringify(message.toolName)} error=${message.isError}`
+			: "";
+	pushText(`<${tag}${attrs}>`);
+	if (typeof message.content === "string") pushText(clipHistoryText(message.content));
+	else
+		for (const part of message.content) {
+			switch (part.type) {
+				case "text":
+					pushText(clipHistoryText(part.text));
+					break;
+				case "image":
+					blocks.push({ type: "image", data: part.data, mimeType: part.mimeType });
+					bytes += 256;
+					break;
+				case "thinking":
+					pushText(`<thinking>${clipHistoryText(part.thinking)}</thinking>`);
+					break;
+				case "toolCall":
+					pushText(
+						`<tool_call id=${JSON.stringify(part.id)} name=${JSON.stringify(part.name)}>${clipHistoryText(stableStringifyJson(part.arguments))}</tool_call>`,
+					);
+					break;
+			}
+		}
+	pushText(`</${tag}>`);
+	return { blocks, bytes };
+}
