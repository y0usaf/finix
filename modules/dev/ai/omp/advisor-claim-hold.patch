+/**
+ * How long a final reply that makes a checkable claim holds its boundary for the
+ * advisor's review. Long enough for a reviewer turn, short enough that a stalled
+ * advisor costs the reply less than the correction it would otherwise need.
+ */
+const ADVISOR_CLAIM_HOLD_MS = 45_000;
+
+/** The text of the last assistant message: the reply about to go out. */
+function lastAssistantText(messages: readonly AgentMessage[]): string | undefined {
+	for (let index = messages.length - 1; index >= 0; index--) {
+		const message = messages[index]!;
+		if (message.role !== "assistant") continue;
+		if (typeof message.content === "string") return message.content;
+		let text = "";
+		for (const part of message.content) if (part.type === "text" && typeof part.text === "string") text += part.text;
+		return text;
+	}
+	return undefined;
+}
+
+/** A measured quantity: a number with a unit, a ratio or a percentage. */
+const CLAIM_MEASUREMENT = /\b\d+(?:\.\d+)?\s*(?:ms|s|m|h|kb|mb|gb|k|tokens?|lines?|files?|%|x)\b|\b\d+\s*(?:of|\/)\s*\d+\b/i;
+/** A cause is named rather than a correlation observed. */
+const CLAIM_CAUSE = /\b(?:root cause|caused by|because|the reason|regression from|due to)\b/i;
+/** A step is reported finished. */
+const CLAIM_COMPLETION = /\b(?:done|shipped|landed|fixed|passes?|passing|verified|committed|merged|complete)\b/i;
+
+/**
+ * Whether a final reply asserts something the advisor can check: a measurement,
+ * a root cause, or a step reported complete. Those are exactly the claims a late
+ * advisory turns into a correction, so their boundary waits for the review; a
+ * reply that asserts none of them settles at once.
+ */
+function claimsConclusion(text: string | undefined): boolean {
+	if (text === undefined) return false;
+	return CLAIM_MEASUREMENT.test(text) || CLAIM_CAUSE.test(text) || CLAIM_COMPLETION.test(text);
+}
