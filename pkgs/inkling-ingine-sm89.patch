diff --git a/native/src/kernels/common/arch.cuh b/native/src/kernels/common/arch.cuh
new file mode 100644
index 0000000..7877c2b
--- /dev/null
+++ b/native/src/kernels/common/arch.cuh
@@ -0,0 +1,25 @@
+// Target switches shared by host and device code. INGINE_AMPERE (CMake, CMAKE_CUDA_ARCHITECTURES=86) is the
+// RTX 3090 port: no programmatic dependent launch (PDL), no thread-block clusters.
+//
+// Without PDL every kernel of a stream starts after its predecessor completed, so griddepcontrol.wait /
+// launch_dependents become no-ops (the wait keeps a compiler memory barrier, so program order around it is
+// unchanged) and launchers drop the programmatic-stream-serialization attribute.
+#pragma once
+
+namespace ingine::kernels {
+
+#ifdef INGINE_AMPERE
+inline constexpr bool kHasPdl = false;
+#else
+inline constexpr bool kHasPdl = true;
+#endif
+
+}  // namespace ingine::kernels
+
+#ifdef INGINE_AMPERE
+#define INGINE_GRIDDEP_WAIT() asm volatile("" ::: "memory")
+#define INGINE_GRIDDEP_LAUNCH() asm volatile("" ::: "memory")
+#else
+#define INGINE_GRIDDEP_WAIT() asm volatile("griddepcontrol.wait;" ::: "memory")
+#define INGINE_GRIDDEP_LAUNCH() asm volatile("griddepcontrol.launch_dependents;" ::: "memory")
+#endif
diff --git a/native/src/kernels/common/fp8.cuh b/native/src/kernels/common/fp8.cuh
new file mode 100644
index 0000000..85a6c10
--- /dev/null
+++ b/native/src/kernels/common/fp8.cuh
@@ -0,0 +1,69 @@
+// Exact E4M3 (FP8) and E2M1 (FP4) -> FP16 decoding for every build target.
+//
+// RTX 5090 builds (sm_120a) use the hardware conversions (cvt.rn.f16x2.e4m3x2 / .e2m1x2), unchanged.
+// The RTX 3090 port (sm_86, INGINE_AMPERE) has neither instruction, and cuda_fp8.h's fallback below sm_89
+// decodes one byte at a time with a normalisation loop for subnormals. Here instead each code is moved
+// into the top of an FP16 field with a byte permute and two masks:
+// * E4M3 s.eeee.mmm -> FP16 s.0eeee.mmm0000000 is the value times 2^-8 (exponent bias 15 vs 7), also for
+//   E4M3 subnormals, which land on FP16 subnormals with the same significand;
+// * E2M1 s.ee.m -> FP16 s.000ee.m000000000 is the value times 2^-14 (exponent bias 15 vs 1);
+// and one __hmul2 by 2^8 / 2^14 restores the value. The product is exact (a power of two times an exact
+// FP16 value, result in the normal range), so every finite code decodes to the same FP16 bits as the
+// hardware instruction. E4M3 NaN (0x7f / 0xff) decodes to +-480 instead of NaN; ingine never holds one:
+// the KV caches and FP8 dense weights are written saturated (SATFINITE) and checkpoint codes are finite.
+#pragma once
+
+#include <cuda_fp16.h>
+
+#include <cstdint>
+
+namespace ingine::kernels::fp {
+
+// Two E4M3 codes (low 16 bits of v, element 0 in the low byte) -> f16x2 (element 0 in the low half).
+__device__ __forceinline__ uint32_t e4m3x2_to_f16x2(uint32_t v) {
+#if !defined(INGINE_AMPERE) || (defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= 890)
+  uint32_t r;
+  asm("cvt.rn.f16x2.e4m3x2 %0, %1;" : "=r"(r) : "h"(static_cast<uint16_t>(v)));
+  return r;
+#else
+  const uint32_t t = __byte_perm(v, 0u, 0x1404);  // bytes [0, e0, 0, e1]: each code in its lane's high byte
+  const uint32_t h = (t & 0x80008000u) | ((t >> 1) & 0x3f803f80u);
+  const __half2 r = __hmul2(*reinterpret_cast<const __half2*>(&h), __half2(__half_raw{0x5c00}, __half_raw{0x5c00}));
+  return *reinterpret_cast<const uint32_t*>(&r);
+#endif
+}
+
+// Eight E2M1 codes (byte i = codes 2i (low nibble) and 2i+1) -> four f16x2: h[i] = (code 2i, code 2i+1).
+__device__ __forceinline__ void e2m1x8_to_f16x2x4(uint32_t w, uint32_t (&h)[4]) {
+#ifndef INGINE_AMPERE
+  asm("{\n"
+      ".reg .b8 b0, b1, b2, b3;\n"
+      "mov.b32 {b0, b1, b2, b3}, %4;\n"
+      "cvt.rn.f16x2.e2m1x2 %0, b0;\n"
+      "cvt.rn.f16x2.e2m1x2 %1, b1;\n"
+      "cvt.rn.f16x2.e2m1x2 %2, b2;\n"
+      "cvt.rn.f16x2.e2m1x2 %3, b3;\n"
+      "}"
+      : "=r"(h[0]), "=r"(h[1]), "=r"(h[2]), "=r"(h[3])
+      : "r"(w));
+#else
+  const uint32_t w4 = w << 4;  // byte i of w4 has code 2i in its high nibble; byte i of w has code 2i+1
+  const __half2 k = __half2(__half_raw{0x7400}, __half_raw{0x7400});  // 2^14
+#pragma unroll
+  for (int i = 0; i < 4; ++i) {
+    // lane 0 high byte = byte i of w4, lane 1 high byte = byte i of w: codes in bits 15..12 / 31..28
+    const uint32_t t = __byte_perm(w4, w, ((4 + i) << 12) | (i << 4));
+    const uint32_t u = (t & 0x80008000u) | ((t >> 3) & 0x0e000e00u);
+    const __half2 r = __hmul2(*reinterpret_cast<const __half2*>(&u), k);
+    h[i] = *reinterpret_cast<const uint32_t*>(&r);
+  }
+#endif
+}
+
+// Two E4M3 codes -> two floats (exact).
+__device__ __forceinline__ float2 e4m3x2_to_float2(uint32_t v) {
+  const uint32_t h = e4m3x2_to_f16x2(v);
+  return __half22float2(*reinterpret_cast<const __half2*>(&h));
+}
+
+}  // namespace ingine::kernels::fp
diff --git a/native/src/kernels/common/group_sync.cuh b/native/src/kernels/common/group_sync.cuh
new file mode 100644
index 0000000..bbd5df7
--- /dev/null
+++ b/native/src/kernels/common/group_sync.cuh
@@ -0,0 +1,38 @@
+// Replacement for thread-block clusters on sm_86/sm_89 (INGINE_AMPERE): the CTAs of a "cluster" exchange data
+// through global memory (L2) and meet at a software barrier.
+#pragma once
+
+#include <cstdint>
+
+namespace ingine::kernels {
+
+struct GroupBarrier {
+  unsigned int count;
+  unsigned int gen;
+};
+
+// All threads of the CTA call this. `wait` = false arrives without waiting (a CTA that exits right after).
+// Uses PTX release/acquire GPU-scope atomics/loads (sm_70+) instead of 4x __threadfence().
+__device__ __forceinline__ void group_sync(GroupBarrier* b, unsigned int n, bool wait = true) {
+  __syncthreads();
+  if (threadIdx.x == 0) {
+    unsigned int g0;
+    asm volatile("ld.relaxed.gpu.global.u32 %0, [%1];" : "=r"(g0) : "l"(&b->gen));
+    unsigned int old;
+    asm volatile("atom.release.gpu.global.add.u32 %0, [%1], 1;" : "=r"(old) : "l"(&b->count) : "memory");
+    if (old == n - 1) {
+      asm volatile("st.relaxed.gpu.global.u32 [%0], 0;" ::"l"(&b->count) : "memory");
+      asm volatile("st.release.gpu.global.u32 [%0], %1;" ::"l"(&b->gen), "r"(g0 + 1u) : "memory");
+    } else if (wait) {
+      unsigned int g;
+      for (;;) {
+        asm volatile("ld.acquire.gpu.global.u32 %0, [%1];" : "=r"(g) : "l"(&b->gen) : "memory");
+        if (g != g0) break;
+        __nanosleep(16);
+      }
+    }
+  }
+  __syncthreads();
+}
+
+}  // namespace ingine::kernels
