          (if' (call "source.exists" []) [
            ["target" "=" "backup" "/" (str "game") "/" "name"]
            (call "target.parent.mkdir" [(kw "parents" "True") (kw "exist_ok" "True")])
            (call "shutil.copy2" ["source" "target"])
