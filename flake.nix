            (kw "children")
            (rows [
              [list [ui (kw "rect") (kw "width") 1 (kw "height") [cassette--px' 10] (kw "background") [cassette--c' (kw "groove")]]]
              [[ui (kw "rect") (kw "width") 1 (kw "height") [cassette--px' 10] (kw "background") [cassette--c' (kw "shine")]]]
