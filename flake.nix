                    (rows [
                      ["list" ["action" ":focus" (quote ":pane") "target"]]
                      [["action" ":set-state" (quote ":value") ["model-state" "model"]]]
                    ])
                  ])
                ])
              ])
            ])
          ])
        ])
      ])
      blank
      (rows [
        ["defun" "move-in-deck" ["dir"]]
        (rows [
          ["lambda" ["snapshot" "event"]]
          [["declare" ["ignore" "event"]]]
