            --no-first-run --no-default-browser-check --disable-sync --noerrdialogs \
            --remote-debugging-address=127.0.0.1 --remote-debugging-port=${toString port} \
            --window-size=1280,900 --user-agent=${lib.escapeShellArg userAgent}
