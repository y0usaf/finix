        ".local/state/tern"
        ".local/state/brain"
      ];

      user.files = files // tuturu;

      finit = {
        tmpfiles.rules = ["d ${config.user.runtimeDir} 0700 ${config.user.name} users"];

        tasks.tern-authorized-keys = {
