      "        state[rel] = md5(new_xdt)"
      "    if state:"
      "        state_dir.mkdir(exist_ok=True)"
      "        write_atomic(state_file, json.dumps(state, indent=2).encode())"
      "    else:"
      "        shutil.rmtree(state_dir, ignore_errors=True)"
      "    if changed:"
      "        print(json.dumps({\"aniimo\": changed}))"
      ""
      ""
