    };
    dev_packages = {
      pkgs,
      inputPackages,
      ...
    }: {
      environment.systemPackages = [
        (pkgs.lib.hiPrio inputPackages.pi.default)
        inputPackages.durapi.default
        pkgs.texliveFull
        pkgs.texstudio
        pkgs.tectonic
        inputPackages.paseo.desktop
      ];
    };
    dev_python = {
      config,
      lib,
      pkgs,
      ...
    }: let
      inherit (config.user) homeDirectory;
    in {
      environment = {
        systemPackages = [
          (pkgs.python3.withPackages (ps: [ps.pillow]))
          pkgs.uv
          pkgs.ninja
          pkgs.meson
          pkgs.pkg-config
          pkgs.cacert
          pkgs.stdenv.cc.cc.lib
          pkgs.zlib
          pkgs.libGL
          pkgs.glib
          pkgs.libx11
          pkgs.libxext
          pkgs.libxrender
          pkgs.gcc
          pkgs.binutils
        ];
        variables = {
          PYTHONSTARTUP = "${homeDirectory}/.config/python/pythonrc";
          PYTHON_HISTORY = "${homeDirectory}/.local/state/python_history";
          PYTHONUSERBASE = "${homeDirectory}/.local/share/python";
          PIP_CACHE_DIR = "${homeDirectory}/.cache/pip";
          VIRTUAL_ENV_HOME = "${homeDirectory}/.local/share/venvs";
          SSL_CERT_FILE = config.security.pki.caBundle;
          REQUESTS_CA_BUNDLE = config.security.pki.caBundle;
          NIX_LD_LIBRARY_PATH = lib.makeLibraryPath [
            pkgs.stdenv.cc.cc.lib
            pkgs.zlib
            pkgs.libGL
            pkgs.glib
