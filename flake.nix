          (if' (not row) (return undefined))
          (const message (infix [(call (dot JSON "parse") [row]) "as" Message]))
          (return (ternary (infix [(dot message "i") "===" i]) message undefined))
        ]))
      ]))
    ]);
    osc_data = {
