      ""
      ""
      "def die(msg):"
      "    sys.exit(f\"aniimo-mods: {msg}\")"
      ""
      ""
      "def read_dir(d):"
      "    xdf = (d / \"LuaScripts.xdf\").read_bytes()"
      "    xdt_raw = (d / \"LuaScripts.xdt\").read_bytes()"
      "    xdt = json.loads(xdt_raw)"
