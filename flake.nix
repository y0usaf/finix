              proto = "9p";
              readOnly = true;
            }
            {
              tag = "natives";
              source = ompBox.nativesDir;
              mountPoint = "${home}/.omp/natives";
              proto = "9p";
              readOnly = true;
            }
            {
              tag = "ompd-jobs";
              source = ompBox.ompdJobsDir;
