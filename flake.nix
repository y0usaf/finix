      formatter.${system} = inputs.nixpkgs.legacyPackages.${system}.alejandra;
    };
    modules_server_amp_orb = {
      lib,
      pkgs,
      ...
    }: let
      home = "/var/lib/amp-orb";
      tokenFile = "${home}/provider-token";
      env = {
        HOME = home;
        XDG_RUNTIME_DIR = "/run/amp-orb";
        TMPDIR = "${home}/tmp";
      };
      podman = "${lib.getExe pkgs.podman} --log-level=error";

      dispatch = pkgs.writeShellScript "amp-orb-dispatch" ''
        set -eu
        case "$ORB_OPERATION" in
          spawn)
            if ! ${podman} container exists "$ORB_ID"; then
              image=$ORB_IMAGE pull=newer
              if [ -n "''${ORB_SNAPSHOT_ID-}" ] && ${podman} image exists "$ORB_SNAPSHOT_ID"; then
                image=$ORB_SNAPSHOT_ID pull=never
              fi
              ${podman} create --quiet --init --pull "$pull" --name "$ORB_ID" "$image" sleep infinity >/dev/null
            fi
            ${podman} start "$ORB_ID" >/dev/null
            ${podman} exec --detach --env ORB_TOKEN ''${AMP_URL:+--env AMP_URL} "$ORB_ID" amp orb bootstrap >/dev/null
            ;;
          pause)
            ${podman} stop --ignore "$ORB_ID" >/dev/null
            if [ -n "''${ORB_SNAPSHOT_ID-}" ]; then
              ${podman} commit --quiet "$ORB_ID" "$ORB_SNAPSHOT_ID" >/dev/null
            fi
            ;;
          delete)
            ${podman} rm --force --ignore "$ORB_ID" >/dev/null
            ${podman} image prune --force >/dev/null
            ;;
          *)
            echo "amp-orb-dispatch: unknown ORB_OPERATION '$ORB_OPERATION'" >&2
            exit 1
            ;;
        esac
      '';
    in {
      imports = [(merge_keyed_module "modules/core/podman.nix" modules_core_podman)];

      users = {
        users.amp-orb = {
          isSystemUser = true;
          uid = 420;
          group = "amp-orb";
          inherit home;
          createHome = true;
        };
        groups.amp-orb.gid = 420;
      };

      environment = {
        etc = {
          "subuid".text = "amp-orb:165536:65536\n";
          "subgid".text = "amp-orb:165536:65536\n";
        };

        systemPackages = [
          (pkgs.writeShellScriptBin "amp-orb-podman" ''
            cd /
            exec sudo -u amp-orb ${lib.concatStringsSep " " (lib.mapAttrsToList (n: v: "${n}=${v}") env)} PATH=/run/wrappers/bin ${podman} "$@"
          '')
        ];
      };

      fileSystems.${home} = {
        device = "/persist${home}";
        fsType = "btrfs";
        options = ["bind"];
        neededForBoot = true;
      };

      finit = {
        tmpfiles.rules = [
          "d /persist${home} 0700 amp-orb amp-orb"
          "d ${env.XDG_RUNTIME_DIR} 0700 amp-orb amp-orb"
          "d ${env.TMPDIR} 0700 amp-orb amp-orb"
        ];

        services.amp-orb = {
          description = "Amp self-hosted orb provider";
          user = "amp-orb";
          group = "amp-orb";
          environment = env;
          path = [pkgs.coreutils pkgs.util-linux "/run/wrappers"];
          command = pkgs.writeShellScript "amp-orb-provider" ''
            set -eu
            mountpoint -q ${home} || {
              echo "amp-orb: ${home} is not mounted from /persist; refusing to fill the root tmpfs" >&2
              exit 1
            }
            [ -s ${tokenFile} ] || {
              echo "amp-orb: no provider token in ${tokenFile}" >&2
              exit 1
            }
            AMP_ORB_PROVIDER_TOKEN=$(cat ${tokenFile})
            export AMP_ORB_PROVIDER_TOKEN
            exec ${lib.getExe pkgs.amp-cli} orb provider ${dispatch}
          '';
          nohup = true;
          log = true;
        };
      };
    };
    modules_server_attic = {
      lib,
      pkgs,
      ...
    }: {
      fileSystems."/var/lib/atticd" = {
        device = "/persist/var/lib/atticd";
        fsType = "btrfs";
        options = ["bind"];
        neededForBoot = true;
      };

      finit.tasks.atticd-keygen = {
        description = "generate atticd RS256 signing keypair if absent";
        command = pkgs.writeShellScript "atticd-keygen" ''
          export PATH=${lib.makeBinPath [pkgs.coreutils pkgs.openssl]}
          install -d -m 0700 /var/lib/atticd
          if [ ! -s /var/lib/atticd/signing.pem ]; then
            openssl genrsa -out /var/lib/atticd/signing.pem.tmp 4096
            chmod 0400 /var/lib/atticd/signing.pem.tmp
            mv /var/lib/atticd/signing.pem.tmp /var/lib/atticd/signing.pem
            echo "atticd-keygen: new signing keypair"
          fi
          {
            printf 'ATTIC_SERVER_TOKEN_RS256_SECRET_BASE64='
            base64 -w0 /var/lib/atticd/signing.pem
            printf '\n'
          } > /var/lib/atticd/token.env.tmp
          chmod 0400 /var/lib/atticd/token.env.tmp
          mv /var/lib/atticd/token.env.tmp /var/lib/atticd/token.env
          install -d -m 0755 /var/lib/atticd/storage
        '';
        log = true;
      };

      services.nix-daemon.settings = {
        substituters = ["http://127.0.0.1:8787/cache"];
        connect-timeout = 5;
      };

      finit.services.atticd = {
        description = "attic binary cache server";
        command = pkgs.writeShellScript "atticd-run" ''
