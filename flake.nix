      "    if md5(xdf) != xdt[\"CMDataMD5\"]:"
      "        die(f\"{d}/LuaScripts.xdf does not match its xdt; verify game files\")"
      "    return xdf, xdt, md5(xdt_raw)"
      ""
      ""
      "def heal(d, backup):"
      "    xdf = d / \"LuaScripts.xdf\""
      "    old = backup / \"LuaScripts.xdf\""
