    ];
    tree_data = {
      Buffer,
      Error,
      Math,
      Number,
      array,
      arrayOf,
      arrow,
      below,
      blank,
      boolean,
      break,
      call,
      class,
      const,
      continue,
      dot,
      export,
      field,
      fn,
      for,
      forOf,
      idx,
      if',
      import',
      inc,
      infix,
      interface,
      let',
      method,
      new,
      not,
      num,
      number,
      obj,
      prop,
      readonly,
      regex,
      return,
      rows,
      spread,
      str,
      string,
