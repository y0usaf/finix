    modules_dev_work_vercel_wrapper_data = [
      "import os"
      "import subprocess"
      "import sys"
      "from pathlib import Path"
      ""
      "args = sys.argv[1:]"
      "cli = '@vercel@/bin/vercel'"
      ""
      ""
      "def fail(message):"
      "    sys.exit(f'vercel: {message}')"
      ""
      ""
      "def run_cli(extra=()):"
      "    os.execv(cli, [cli, *extra, *args])"
      ""
      ""
      "if any(arg in ('--token', '-t', '--global-config', '-Q') or"
      "       arg.startswith(('--token=', '--global-config=')) for arg in args):"
      "    run_cli()"
      ""
      "if '--help' in args or '-h' in args or not args:"
      "    print('Account routing: VERCEL_ACCOUNT=personal|work, then '"
      "          'recognized GitHub origin owner.\\n'"
      "          'Use vercel-personal login or vercel-work login to authenticate.\\n'"
      "          'Inspect the selected login with vercel whoami.', flush=True)"
      "    if args:"
      "        run_cli()"
      ""
      "cwd = os.getcwd()"
      "for index, arg in enumerate(args):"
      "    if arg == '--cwd':"
      "        if index + 1 == len(args):"
      "            fail('--cwd requires a directory')"
      "        cwd = args[index + 1]"
      "    elif arg.startswith('--cwd='):"
      "        cwd = arg.split('=', 1)[1]"
      "if not Path(cwd).is_dir():"
      "    fail(f'directory does not exist: {cwd}')"
      ""
      ""
      "def git(*arguments):"
      "    result = subprocess.run(['@git@/bin/git', '-C', cwd, *arguments],"
      "                            capture_output=True, text=True)"
      "    return result.stdout.strip() if result.returncode == 0 else ''"
      ""
      ""
      "account = os.environ.get('VERCEL_ACCOUNT')"
      "if not account:"
      "    origin = git('remote', 'get-url', 'origin')"
      "    for prefix in ('git@github.com:', 'https://github.com/', 'ssh://git@github.com/'):"
      "        if origin.startswith(prefix):"
      "            owner = origin.removeprefix(prefix).split('/')[0].lower()"
      "            account = @owners@.get(owner, '')"
      "            break"
      "if account not in ('personal', 'work'):"
      "    fail('use vercel-personal/vercel-work or set VERCEL_ACCOUNT=personal|work')"
      ""
      "profile = Path(os.environ.get('XDG_DATA_HOME', str(Path.home() / '.local/share'))) \\"
      "    / 'com.vercel.cli' / 'profiles' / account"
      "profile.mkdir(parents=True, exist_ok=True, mode=0o700)"
      "run_cli(['--global-config', str(profile)])"
    ];
    modules_drift = {
      lib,
      pkgs,
      hosts,
    }: let
      unquote = s: lib.concatStrings (lib.splitString "\"" s);

      enabled = host: prefix: let
        names = map (o: unquote o.name) (lib.optionAttrSetToDocList host.options);
        hits = builtins.filter (n: lib.hasInfix "enab" n && lib.hasPrefix prefix n && !(lib.hasInfix "<" n)) names;
        on = n: let v = builtins.tryEval (lib.getAttrFromPath (lib.splitString "." n) host.config); in v.success && builtins.isBool v.value && v.value;
      in
        builtins.filter on hits;

      dump = host: let
        c = host.config;
        names = map (p: p.pname or p.name or "?") c.environment.systemPackages;
        uid = c.users.users.${c.user.name}.uid or null;
        paths = c.finix.persistence.allowlist.users.${c.user.name}.directories ++ c.finix.persistence.allowlist.directories;
        lines =
          map (n: "package " + n) names
          ++ map (n: "service " + n) (enabled host "services.")
          ++ map (n: "program " + n) (enabled host "programs.")
          ++ map (n: "option " + n) (enabled host "user.")
          ++ map (p: "persist " + p) paths
          ++ lib.optional (uid != null) ("uid " + toString uid);
      in
        lib.concatStringsSep "\n" (lib.sort lib.lessThan lines) + "\n";

      dumps = lib.mapAttrs (name: host: pkgs.writeText ("drift-" + name) (dump host)) hosts;
      hostNames = lib.concatStringsSep " " (builtins.attrNames dumps);
      arms = lib.concatStrings (lib.mapAttrsToList (name: path: "      " + name + ") f=" + path + " ;;\n") dumps);
    in
      pkgs.writeShellScriptBin "drift" ''
            set -eu
            case "''${1:-}" in
              "")
                echo "hosts: ${hostNames}"
                echo "usage: drift <host> [other-host]"
                exit 0
                ;;
        ${arms}      *)
                echo "drift: unknown host; one of: ${hostNames}" >&2
                exit 2
                ;;
            esac
            f1="$f"
            if [ "$#" = 1 ]; then
              cat "$f1"
              exit 0
            fi
            case "$2" in
        ${arms}      *)
                echo "drift: unknown host; one of: ${hostNames}" >&2
                exit 2
                ;;
            esac
            exec ${pkgs.diffutils}/bin/diff -u --label "$1" --label "$2" "$f1" "$f" || true
      '';
    modules_finix_chrony = {pkgs, ...}: {
      services.chrony = {
        enable = true;
        configFile = pkgs.writeText "chrony.conf" ''
          pool pool.ntp.org iburst
          makestep 1.0 3
          rtcsync
          driftfile /var/lib/chrony/drift
        '';
      };
    };
    modules_finix_common = {
      config,
      generators,
      lib,
      pkgs,
      ...
    }: let
      user = config.user.name;
      persistedSshDir = "/persist/etc/ssh";
    in {
      options.user = {
        name = lib.mkOption {
          type = lib.types.str;
          default = "y0usaf";
          description = "Primary username for the system";
        };

        homeDirectory = lib.mkOption {
          type = lib.types.path;
          default = "/home/${config.user.name}";
          description = "Home directory path for the user";
        };

        uid = lib.mkOption {
          type = lib.types.int;
          default = 1000;
          description = "Numeric uid of the primary user. The persisted home is owned by this number, so changing it renumbers every file under /persist/home.";
        };
      };

      config = {
        time.timeZone = "America/Toronto";

        environment.etc."profile.d/system-path.sh".text = ''
          case ":$PATH:" in
            *:/run/current-system/sw/bin:*) ;;
            *)
              export PATH="$PATH:/etc/profiles/per-user/${user}/bin:${config.user.homeDirectory}/.nix-profile/bin:/run/wrappers/bin:/run/current-system/sw/bin"
              ;;
          esac
        '';

        networking.hosts = {
          "127.0.0.1" = ["localhost"];
          "::1" = ["localhost"];
          "127.0.0.2" = [config.networking.hostName];
        };

        services = {
          sysklogd = {
            enable = true;
            extraConfig = ''
              rotate_size 256M
              rotate_count 10
            '';
          };
          openssh = {
            enable = true;
            settings = {
              PasswordAuthentication = false;
              PermitRootLogin = "no";
              HostKey = lib.mkForce ["${persistedSshDir}/ssh_host_ed25519_key"];
              AuthorizedKeysFile = lib.mkForce ["${persistedSshDir}/authorized_keys.d/%u"];
            };
          };
          nix-daemon = {
            enable = true;
            settings.trusted-users = lib.mkForce ["root" user];
          };
        };

        programs.bash.enable = true;

        manzil.forceByDefault = true;

        finit.tasks = {
          remount-nix-store.enable = false;
          ssh-keygen.command = lib.mkForce (pkgs.writeShellScript "check-host-keys" ''
            [ -s ${persistedSshDir}/ssh_host_ed25519_key ]
          '');
          efi-pstore-drain = {
            description = "drain EFI pstore dumps so the NVRAM stays writable";
            command = pkgs.writeShellScript "efi-pstore-drain" ''
              export PATH=${lib.makeBinPath [pkgs.coreutils pkgs.e2fsprogs pkgs.util-linux]}
              vars=/sys/firmware/efi/efivars
              for _ in $(seq 1 30); do
                mountpoint -q "$vars" && break
                sleep 1
              done
              mountpoint -q "$vars" || exit 0
              n=0
              for f in "$vars"/dump-*; do
                [ -e "$f" ] || continue
                chattr -i "$f" 2>/dev/null || true
                rm -f "$f" && n=$((n + 1))
              done
              [ "$n" -eq 0 ] || echo "efi-pstore-drain: removed $n stale crash dumps"
            '';
            log = true;
          };
        };

        system.activation.scripts.persistentSshAuthorizedKeys = {
          deps = ["etc"];
          text = ''
            ${pkgs.coreutils}/bin/install -d -m 0755 ${persistedSshDir}/authorized_keys.d
            ${pkgs.coreutils}/bin/install -m 0644 -o root -g root \
              /etc/ssh/authorized_keys.d/${user} \
              ${persistedSshDir}/authorized_keys.d/${user}
          '';
        };

        environment = {
          etc."ssh/authorized_keys.d/y0usaf".text = ''
            ${generators.sshPublicKey modules_hosts_y0usaf_desktop_user_ssh_data}
            ${generators.sshPublicKey modules_hosts_y0usaf_framework_user_ssh_data}
            ${generators.sshPublicKey modules_hosts_y0usaf_server_user_ssh_data}
            ${generators.sshPublicKey modules_hosts_android_phone_user_ssh_data}
          '';
          shells = [
            "/run/current-system/sw/bin/rush"
            "${pkgs.rush}/bin/rush"
            "/run/current-system/sw/bin/ash"
            "${pkgs.ash}/bin/ash"
          ];
          systemPackages = [
            pkgs.curl
            pkgs.iproute2
            pkgs.iputils
            pkgs.procps
            pkgs.util-linux
            pkgs.vim
            pkgs.rush
            pkgs.ash
          ];
        };

        users.users.y0usaf = {
          isNormalUser = true;
          inherit (config.user) uid;
          home = "/home/y0usaf";
          shell = "${pkgs.rush}/bin/rush";
          extraGroups = ["wheel"];
          passwordFile = "/persist/secrets/password-hashes/${user}";
        };
      };
    };
    modules_finix_desktop = {
