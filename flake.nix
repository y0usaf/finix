              (rows [
                [values state]
                (rows [
                  [
                    append
                    (rows [
                      [list [interval (kw "sample") [getf (constant cassette) (kw "sample")]]]
                      [[publish-state (kw "hud-hot") [and hot t]]]
                    ])
                  ]
                  (rows [
                    [when [and output [plusp tray-height]]]
                    [
