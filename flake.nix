              [chime kind id]
            ])
        ]))
        (assign seeded true)
      ]))
      blank
      (comment "-- The timer re-arms first so one bad tick can't stop the loop.")
      (localFunction tick [{cx = opt WindowCx;}] ({
        cx,
        ok,
        err,
      }: [
