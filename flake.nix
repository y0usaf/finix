            "&&"
            (str "name")
            "in"
            entry
            "&&"
            (typeof (dot entry "name"))
            "==="
            (str "string")
            "&&"
            (str "kind")
            "in"
            entry
            "&&"
            (typeof (dot entry "kind"))
            "==="
            (str "string")
