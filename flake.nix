                > $out/bin/${name}
              chmod 755 $out/bin/${name}
              runHook postInstall
            ''
            else ''
              runHook preInstall
              install -Dm755 ${name} $out/bin/${name}
              runHook postInstall
            '';

          meta = {
            inherit description;
            homepage = "https://github.com/kunchenguid/${name}";
            license = lib.licenses.mit;
            mainProgram = name;
            platforms = ["x86_64-linux"];
            sourceProvenance = [lib.sourceTypes.binaryNativeCode];
