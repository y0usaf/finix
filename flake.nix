      const float TUBE = 0.33;
      const float SINK = -1.0;
      const float TILT = 1.0;
      const float SWAY = 0.35;
      const float FOG_TOP = -0.2;
      const float FOG_BOTTOM = -1.1;
      const float SOFT = 0.05;
      const float BEND = 0.7;

      mat2 rot(float a) {
          float c = cos(a);
          float s = sin(a);
          return mat2(c, -s, s, c);
