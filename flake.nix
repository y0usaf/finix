        (for "name" (call "reversed" ["files"]) [
          ["target" "=" "game" "/" "name"]
          (call "target.parent.mkdir" [(kw "parents" "True") (kw "exist_ok" "True")])
          ["temporary" "=" (call "target.with_name" [["target.name" "+" (str ".finix-new")]])]
