      "\t\tsince[ev.pane] = os.time()"
      "\t\tsave_map(\"rail_since\", since)"
      "\tend"
      "\tif ev.new == \"working\" and unseen[ev.pane] then"
      "\t\tunseen[ev.pane] = nil"
