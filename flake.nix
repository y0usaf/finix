          ["destructuring-bind" ["x" "y" "w" "h"]]
          (rows [
            ["let" [["f" ["getf" "pane" ":floating"]]]]
            (rows [
              ["if" ["and" ["listp" "f"] ["=" ["length" "f"] 4]] "f"]
              (rows [
                ["list" ["+" "left" ["*" 3 ["mod" "index" 8]]] ["+" "top" ["mod" "index" 8]]]
