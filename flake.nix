            export PATH=${lib.makeBinPath [pkgs.coreutils]}
            for _ in $(seq 1 60); do
              [ -d ${runtimeDir} ] && exec "$@"
              sleep 1
            done
            echo "wait-runtime-dir: ${runtimeDir} never appeared" >&2
