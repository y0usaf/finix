    };
    omp_bot = {
      config,
      lib,
      pkgs,
      flakeInputs,
      inputPackages,
      ...
    }: let
      userName = config.user.name;
      home = config.user.homeDirectory;
      inherit (config.user) runtimeDir;
      inherit (inputPackages.oh-my-pi) omp;
      src = flakeInputs.omp-bot;
      tools = [pkgs.bun pkgs.jq pkgs.util-linux pkgs.age pkgs.openssh pkgs.gnutar pkgs.bash];
      persistentHome = "/persist/home/${userName}";
      # The links to omp's extensions the ai_omp module keeps, named the same as in its config.yml, so a bot with
      # "extensions": true loads each once and a switch shows a running bot no new extension path.
      ext = "${home}/.omp/agent/ext";
      # Prints the persist paths of every bot on the persisted roster, relative to home, for persist-user-binds.
      persistPaths = pkgs.writeShellScript "omp-bot-persist-paths" ''
        roster=${persistentHome}/.local/state/omp-bot/bots.json
        [ -r "$roster" ] || exit 0
        ${pkgs.jq}/bin/jq -r '.[] | objects | .persist | arrays | .[] | strings' "$roster" | while IFS= read -r path; do
          case $path in
            "~/"?*) printf '%s\n' "''${path#"~/"}" ;;
            ${home}/?*) printf '%s\n' "''${path#${home}/}" ;;
            *) echo "omp-bot-persist-paths: $path is not inside ${home}, so it is not persisted" >&2 ;;
          esac
        done
      '';
      # bin/omp-bot's OMP_BOT_PERSIST hook. mount PATH: keep PATH in ${persistentHome} from now on, copying
      # what it holds the first time, and bind it over PATH (persist-user-binds does it at boot). purge PATH:
      # unmount it and delete both copies, only ever called by omp-bot-remove --purge.
      persist = pkgs.writeShellScript "omp-bot-persist" ''
        set -euo pipefail
        export PATH=${pkgs.lib.makeBinPath [pkgs.coreutils pkgs.util-linux]}:$PATH
        usage="usage: omp-bot-persist mount|purge PATH..."
        [ $# -ge 2 ] || { echo "$usage" >&2; exit 2; }
        cmd=$1
        shift
        for path in "$@"; do
          case $path in
            ${home}/?*) relative=''${path#${home}/} ;;
            *) echo "omp-bot-persist: $path is not inside ${home}" >&2; exit 1 ;;
          esac
          case "/$relative/" in
            */../* | */./* | *//*) echo "omp-bot-persist: $path is not a plain path" >&2; exit 1 ;;
          esac
          src=${persistentHome}/$relative
          case $cmd in
            mount)
              mountpoint -q "$path" && continue
              if [ ! -d "$src" ]; then
                mkdir -p "$(dirname "$src")"
                rm -rf "$src.new"
                if [ -d "$path" ]; then cp -a "$path" "$src.new"; else mkdir "$src.new"; fi
                mv "$src.new" "$src"
              elif [ -n "$(ls -A "$path" 2>/dev/null)" ]; then
                echo "omp-bot-persist: $src already holds $path; mounting it over what $path gained since boot" >&2
              fi
              mkdir -p "$path"
              /run/wrappers/bin/sudo -n mount --bind "$src" "$path"
              echo "$path"
              ;;
            purge)
              while mountpoint -q "$path"; do /run/wrappers/bin/sudo -n umount "$path"; done
              rm -rf -- "$src" "$path"
              ;;
            *) echo "$usage" >&2; exit 2 ;;
          esac
        done
      '';
      command = name:
        pkgs.writeShellScriptBin name ''
          PATH=${pkgs.lib.makeBinPath tools}:$PATH exec ${src}/bin/${name} "$@"
        '';
      start = pkgs.writeShellScript "omp-botd-start" ''
        set -euo pipefail
        key=${home}/Tokens/AI_GATEWAY_API_KEY.txt
        if [ -r "$key" ]; then
          AI_GATEWAY_API_KEY=$(${pkgs.coreutils}/bin/cat "$key") || { echo "omp-botd: cannot read $key" >&2; exit 1; }
          export AI_GATEWAY_API_KEY
        fi
        exec ${src}/bin/omp-botd
      '';
      ompd = pkgs.writeShellScript "ompd-start" ''
        set -euo pipefail
        logs=${home}/.local/state/omp-bot/logs
        ${pkgs.coreutils}/bin/mkdir -p "$logs" || { echo "ompd: cannot create $logs" >&2; exit 1; }
        exec ${src}/bin/ompd serve --wait >>"$logs/ompd.log" 2>&1
      '';
    in {
      user.persist = {
        directories = [".local/state/omp-bot"];
        directorySources = [persistPaths];
      };
      finix.persistence.homeServices = ["omp-botd" "ompd"];

      environment.systemPackages = [(command "omp-bot") (command "omp-bot-ctl") pkgs.age pkgs.gnutar];

      user.files = {
        ".config/omp-bot/env".text = ''
          : "''${OMP_BIN:=${omp}/bin/omp}"
          : "''${OMP_BOT_EXTENSION:=${ext}/crest-auth.ts}"
          : "''${OMP_BOT_CWD_EXTENSION:=${ext}/cwd.ts}"
          : "''${OMP_BOT_SECRETS_EXTENSION:=${ext}/secrets/secrets.ts}"
          : "''${OMP_BOT_WORK_FOLD_EXTENSION:=${ext}/work-fold.ts}"
          : "''${OMP_BOT_CHAT_LOOK_EXTENSION:=${ext}/chat-look.ts}"
          : "''${OMP_BOT_OMPD_EXTENSION:=${ext}/omp-bot/omp/ompd.ts}"
          : "''${OMP_BOT_OPTCHAT:=${ext}/optchat}"
          export OMPD_SERVICE="''${OMPD_SERVICE-1}"
          : "''${OMP_BOT_PERSIST:=${persist}}"
        '';
        ".config/tern/plugins/omp-bot.path".text = "${src}/tern\n";
        ".config/tern/plugins/task-board.path".text = "${src}/task-board\n";
      };

      finit.services.omp-botd = {
        description = "omp-bot task supervisor (${userName})";
        user = userName;
        group = "users";
        command = "${start}";
        environment = {
          HOME = home;
          XDG_RUNTIME_DIR = runtimeDir;
        };
        path = lib.mkMerge [(tools ++ [pkgs.coreutils]) (lib.mkAfter ["/run/current-system/sw" "/run/wrappers"])];
        respawn = true;
        stop-timeout = 130;
        log = true;
      };

      finit.services.ompd = {
        description = "omp-bot job daemon (${userName})";
        user = userName;
        group = "users";
        command = "${ompd}";
        environment = {
          HOME = home;
          XDG_RUNTIME_DIR = runtimeDir;
        };
        path = lib.mkMerge [(tools ++ [pkgs.coreutils]) (lib.mkAfter ["/run/current-system/sw" "/run/wrappers"])];
        cgroup.system.delegate = true;
        respawn = true;
        log = true;
      };
    };
    omp_box = {
      lib,
      pkgs,
      generators,
      omp,
      shares ? [],
      user ? "y0usaf",
    }: let
      staticArms = lib.concatMapStringsSep "\n    " (p: ''case "$PWD/" in ${p}/*) allowed=1 ;; esac'') shares;
      wrapper = pkgs.writeShellScriptBin "omp" ''
        set -eu
        state="''${XDG_STATE_HOME:-$HOME/.local/state}/omp-box"
        key="$state/ssh-key"
        allowed=0
        ${staticArms}
        if [ -d "$state/grants" ]; then
          for grant in "$state/grants"/*; do
            [ -e "$grant" ] || continue
            granted=$(cut -f1 "$grant")
            case "$PWD/" in "$granted"/*) allowed=1 ;; esac
          done
        fi
        seed=""
        if [ "$allowed" != 1 ]; then
          base="''${PWD%/}"
          hint=" (omp-box add $PWD to share it)"
          case "$HOME/" in "$base"/*) hint=" (omp-box add a folder inside it to share)" ;; esac
          case "$state/" in "$base"/*) hint=" (omp-box add a folder inside it to share)" ;; esac
          printf 'omp-box: %s is the box copy, not the host folder%s\n' "$PWD" "$hint" >&2
          seed="mkdir -p $(printf %q "$PWD") && "
        fi
        tty=-T
        [ -t 0 ] && [ -t 1 ] && tty=-t
        exec ${pkgs.openssh}/bin/ssh -q -p 22422 -i "$key" \
          -o LogLevel=ERROR -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no \
          -o BatchMode=yes -o SendEnv=TERM $tty ${user}@127.0.0.1 \
          "exec sh -c $(printf %q "$seed cd $(printf %q "$PWD") && exec ${omp}/bin/omp $(for a in "$@"; do printf %q "$a"; printf ' '; done)")"
      '';
      local = pkgs.writeShellScriptBin "omp-local" ''exec ${omp}/bin/omp "$@"'';
      cli = pkgs.writeShellApplication {
        name = "omp-box";
        runtimeInputs = [pkgs.coreutils pkgs.util-linux pkgs.openssh pkgs.findutils pkgs.jq];
        text = generators.shell.render (omp_box_data generators.shell);
      };
    in
      pkgs.symlinkJoin {
        name = "omp-box";
        paths = [
          wrapper
          cli
          local
        ];
      };
    omp_box_data = {
      HOME,
      IFS,
      XDG_STATE_HOME,
      ansic,
      argCount,
      args,
      argsJoined,
      arm,
      array,
      assign,
      blank,
      case,
      chain,
      default,
      dq,
      dropSuffix,
      elements,
      exists,
      fn,
      for,
      heredoc,
      if',
      inline,
      isDir,
      nonEmpty,
      pipe,
      redir,
      required,
      shebang,
      sq,
      sub,
      test,
      var,
      while,
      word,
      ...
    }: ({
      state,
      grants,
      shares,
      key,
      port,
      target,
      ssh,
      usage,
      up,
      fail,
      covers,
      mount_guest,
      unmount_guest,
      apply_host,
      drop_host,
      cmd_add,
      cmd_rm,
      cmd_list,
      f,
      cmd_reconcile,
      cmd_retry,
    }: [
      (shebang "/usr/bin/env bash")
      ["set" "-euo" "pipefail"]
      blank
      (assign state (dq [(default XDG_STATE_HOME (word [(var HOME) "/.local/state"])) "/omp-box"]))
      (assign grants (dq [(var state) "/grants"]))
      (assign shares (dq [(var state) "/shares"]))
      (assign key (dq [(var state) "/ssh-key"]))
      (assign port 22422)
      (assign target "y0usaf@127.0.0.1")
      (assign ssh (array ["ssh" "-q" "-p" (dq (var port)) "-i" (dq (var key)) "-o" "LogLevel=ERROR" "-o" "UserKnownHostsFile=/dev/null" "-o" "StrictHostKeyChecking=no" "-o" "BatchMode=yes" "-o" "ConnectTimeout=2" "-o" "ServerAliveInterval=2" "-o" "ServerAliveCountMax=1"]))
      blank
      (fn usage [
        [
          "cat"
          (heredoc "EOF" ''
            usage: omp-box <command>

              list [--json]        granted folders
              add PATH [--copy | --ro] [--name NAME]
                                   share PATH into the box at the same path, as grant NAME
                                   (default: PATH's folder name); --copy shares a copy,
                                   --ro shares it read-only
              rm NAME              revoke a grant
              reconcile            re-apply every grant (after a box restart)
              retry                start the box again after omp-box-run gave up on it
          '')
        ]
      ])
      blank
      (fn up (inline [[(dq (elements ssh)) (dq (var target)) "true" (redir "2>" "/dev/null")]]))
      blank
      (fn fail (inline [["printf" (sq "omp-box: %s\\n") (dq (var argsJoined)) (redir ">&" 2)] ["exit" 1]]))
      blank
      (fn covers ({base}: inline [["local" (assign base (dropSuffix 1 "/"))] (case (dq [(var 2) "/"]) (inline [(arm (word [(dq (var base)) "/*"]) (inline [["return" 0]])) (arm "*" (inline [["return" 1]]))]))]))
      blank
      (fn mount_guest ({
        name,
        path,
      }: [
        ["local" (assign name (var 1)) (assign path (var 2))]
        [
          (dq (elements ssh))
          (dq (var target))
          (dq [
            ''
              set -e
                  p=''
            (sub [["printf" "%q" (dq (var path))]])
            "\n    /run/wrappers/bin/sudo mkdir -p \"$(dirname \"$p\")\" \"$p\"\n    /run/wrappers/bin/sudo mountpoint -q \"$p\" || /run/wrappers/bin/sudo mount --bind "
            (sub [["printf" "%q" (dq ["/mnt/shares/" (var name)])]])
            " \"$p\""
          ])
        ]
      ]))
      blank
      (fn unmount_guest ({path}: [
        ["local" (assign path (var 1))]
        (chain [[(dq (elements ssh)) (dq (var target)) (dq ["/run/wrappers/bin/sudo mountpoint -q " (sub [["printf" "%q" (dq (var path))]]) " && /run/wrappers/bin/sudo umount " (sub [["printf" "%q" (dq (var path))]]) " || true"]) (redir "2>" "/dev/null")] "||" ["true"]])
      ]))
      blank
      (fn apply_host ({
        name,
        path,
        mode,
      }: [
        ["local" (assign name (var 1)) (assign path (var 2)) (assign mode (var 3))]
        ["mkdir" "-p" (dq [(var shares) "/" (var name)])]
        (let
          share = dq [(var shares) "/" (var name)];
          bind = chain [["findmnt" "-n" "-o" "TARGET" share (redir ">" "/dev/null") (redir "2>&" 1)] "||" ["/run/wrappers/bin/sudo" "-n" "mount" "--bind" (dq (var path)) share]];
        in
          case (var mode) [
            (arm "copy" (inline [["cp" "-au" (dq [(var path) "/."]) (dq [(var shares) "/" (var name) "/"])]]))
            (arm "bind" (inline [bind]))
            (arm "ro" (inline [bind (if' ["test" "-w" share] (inline [["/run/wrappers/bin/sudo" "-n" "mount" "-o" "remount,bind,ro" share]]))]))
          ])
      ]))
      blank
      (fn drop_host ({
        name,
        mode,
      }: [
        ["local" (assign name (var 1)) (assign mode (var 2))]
        (if' (test [(dq (var mode)) "!=" "copy"]) [
          (if' ["findmnt" "-n" "-o" "TARGET" (dq [(var shares) "/" (var name)]) (redir ">" "/dev/null") (redir "2>&" 1)] (inline [(chain [["/run/wrappers/bin/sudo" "-n" "umount" (dq [(var shares) "/" (var name)])] "||" [fail (dq ["could not unmount " (var shares) "/" (var name) ", so the grant stays"])]])]))
        ])
        (chain [["findmnt" "-n" "-o" "TARGET" (dq [(var shares) "/" (var name)]) (redir ">" "/dev/null") (redir "2>&" 1)] "||" ["rm" "-rf" (dq [(required shares "") "/" (required name "")])]])
      ]))
      blank
      (fn cmd_add ({
        path,
        mode,
        name,
      }: [
        ["local" (assign path (dq "")) (assign mode "bind") (assign name (dq ""))]
        (while (test [(var argCount) "-gt" 0]) [
          (case (var 1) [(arm "--copy" (inline [(assign mode "copy")])) (arm "--ro" (inline [(assign mode "ro")])) (arm "--name" (inline [(assign name (default 2 "")) ["shift"]])) (arm "*" (inline [(assign path (var 1))]))])
          ["shift"]
        ])
        (chain [(test (nonEmpty (dq (var path)))) "||" [fail (dq "add needs a path")]])
        (assign path (sub [["realpath" "-e" "--" (dq (var path))]]))
        (chain [(test (isDir (dq (var path)))) "||" [fail (dq [(var path) " is not a directory"])]])
        (if' [covers (dq (var path)) (dq (sub [["realpath" "-m" "--" (dq (var state))]]))] (inline [[fail (dq [(var path) " holds the share directory itself, so sharing it loops"])]]))
        (if' [covers (dq (var path)) (dq (var HOME))] (inline [[fail (dq [(var path) " covers " (var HOME) ", where the box keeps its own state; share a folder inside it"])]]))
        (chain [(test (nonEmpty (dq (var name)))) "||" (assign name (sub [["basename" "--" (dq (var path))]]))])
        (assign name (sub [(pipe [["printf" "%s" (dq (var name))] ["tr" "-cd" (sq "A-Za-z0-9._-")]])]))
        (chain [(test (nonEmpty (dq (var name)))) "||" [fail (dq "the grant needs a name of letters, digits, '.', '_' or '-'")]])
        (chain [(test (exists (dq [(var grants) "/" (var name)]))) "&&" [fail (dq ["grant '" (var name) "' already exists (rm it first)"])]])
        ["mkdir" "-p" (dq (var grants)) (dq (var shares))]
        [apply_host (dq (var name)) (dq (var path)) (dq (var mode))]
        ["printf" (sq "%s\\t%s\\n") (dq (var path)) (dq (var mode)) (redir ">" (dq [(var grants) "/" (var name)]))]
        (if' [up] (inline [(chain [[mount_guest (dq (var name)) (dq (var path))] "||" [fail (dq "granted on the host, but the box did not take it")]])]))
        ["printf" (sq "%s  %s  %s\\n") (dq (var name)) (dq (var mode)) (dq (var path))]
