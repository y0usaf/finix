          while [ $# -gt 0 ]; do
            case $1 in
              -d|--dry) dry="--dry" ;;
              -u|--update) update="--update" ;;
              -du|-ud) dry="--dry"; update="--update" ;;
              --nix) nix=1 ;;
              *) break ;;
            esac
            shift
          done
          if [ -n "$nix" ]; then
            GC_DONT_GC=1 nh os switch $update $dry "$@"
            return
          fi
          if [ -n "$update" ]; then
            nix flake update --flake "$NH_FLAKE" || return
          fi
          local out="$XDG_RUNTIME_DIR/nhs-system"
